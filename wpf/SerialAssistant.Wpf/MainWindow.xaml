<Window x:Class="SerialAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SerialAssistant"
        Title="简约串口助手" Height="760" Width="1280"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UIFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <TextBlock Text="简约串口助手" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{StaticResource Accent}"/>
            <TextBlock Text="Serial Assistant" FontSize="12"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource TextSecondary}"/>
            <ToggleButton x:Name="SplitButton" Content="分屏" IsChecked="True" Margin="14,0,0,0"
                          ToolTip="开启后左右各显示一个串口，可同时观察两个串口"/>
            <Button x:Name="RefreshAllButton" Content="刷新全部串口" Margin="6,0,0,0"/>
        </ToolBar>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="*"/>
                <ColumnDefinition x:Name="SplitterCol" Width="6"/>
                <ColumnDefinition x:Name="RightCol" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：串口 1 -->
            <GroupBox x:Name="LeftGroup" Grid.Column="0" Header="串口 1（左）" Margin="0,0,4,0">
                <local:SerialSessionView x:Name="LeftSession"/>
            </GroupBox>

            <!-- 分隔条：可拖拽调整左右宽度 -->
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource Border}"/>

            <!-- 右栏：串口 2 -->
            <GroupBox x:Name="RightGroup" Grid.Column="2" Margin="4,0,0,0">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="串口 2（右）" VerticalAlignment="Center"
                                   Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                        <Button x:Name="CloseRightButton" Content="✕" Width="26" Height="24"
                                Margin="12,0,0,0" Padding="0" ToolTip="关闭右侧串口"/>
                    </StackPanel>
                </GroupBox.Header>
                <local:SerialSessionView x:Name="RightSession"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
