<UserControl x:Class="SerialAssistant.FloatingCommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SerialAssistant"
             mc:Ignorable="d"
             Width="440" Height="400"
             d:DesignHeight="400" d:DesignWidth="440">

    <Border Background="{StaticResource CardBg}"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="1.5"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：拖动区 + 关闭 -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{StaticResource PanelBg}"
                    CornerRadius="10,10,0,0"
                    Cursor="SizeAll"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="命令表"
                               Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                    <Button x:Name="CloseButton" Grid.Column="1"
                            Content="✕" Width="26" Height="24"
                            Margin="0,0,8,0" Padding="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="4,2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Danger}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 输入行 -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="NameBox" Width="82"
                             Margin="0,0,4,0" VerticalContentAlignment="Center"
                             ToolTip="命令名称(可选)" Text="名称"/>
                    <TextBox x:Name="ContentBox" Width="150"
                             Margin="0,0,4,0" VerticalContentAlignment="Center"
                             ToolTip="命令内容" Text="命令内容"/>
                    <Button x:Name="AddButton" Content="加入" Margin="2"
                            Style="{StaticResource AccentButton}"/>
                    <Button x:Name="ImportButton" Content="导入" Margin="2"/>
                    <Button x:Name="RemoveButton" Content="删除" Margin="2"/>
                    <Button x:Name="SendSelButton" Content="发送选中" Margin="2"
                            Style="{StaticResource AccentButton}"/>
                </WrapPanel>

                <!-- 命令列表 -->
                <DataGrid x:Name="CommandsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="Auto" IsReadOnly="False"/>
                        <DataGridTextColumn Header="命令内容" Binding="{Binding Content}" Width="*" IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
